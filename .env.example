# ---------------------------------------------------------------------------
# ProxiSpeak — copy to `.env` (repo root). server/.env overrides this file.
# In production (Render) the same names are set as environment variables.
# ---------------------------------------------------------------------------

# --- Core ------------------------------------------------------------------
# PORT is injected automatically by Render; keep 4000 for local development.
PORT=4000
# `production` enables caching, static asset handling and origin warnings.
NODE_ENV=development
# Remote-capable connection string:
#   local:  mongodb://127.0.0.1:27017/proxispeak
#   Atlas:  mongodb+srv://user:pass@cluster.mongodb.net/proxispeak?retryWrites=true&w=majority
MONGO_URI=mongodb://127.0.0.1:27017/proxispeak

# Allowed browser origins (comma separated), or `*` to reflect any.
# Leave EMPTY for a single-origin deployment (Express serves the bundle and the
# websocket itself). Set it in production to lock the app down, e.g.
#   CLIENT_URL=https://proxispeak.onrender.com
CLIENT_URL=http://localhost:5173

# --- Redis (Pub/Sub + Socket.io horizontal scaling) -------------------------
# rediss:// is detected and connected over TLS (Render's managed Redis).
# Leave empty to boot in single-instance mode (no adapter, no Pub/Sub).
REDIS_URL=redis://127.0.0.1:6379

# --- WebRTC ----------------------------------------------------------------
# Public STUN only. No TURN, no extra service.
STUN_URL=stun:stun.l.google.com:19302

# --- Static client (optional) ----------------------------------------------
# Where the built bundle lives. Defaults to <repo>/client/dist.
# CLIENT_DIST=./client/dist

# --- World / spatial tuning ------------------------------------------------
WORLD_WIDTH=1920
WORLD_HEIGHT=1080
WORLD_CENTER_LAT=37.7749
WORLD_CENTER_LON=-122.4194
# 1 pixel in metres. 100 px of earshot === 10 m in MongoDB.
PIXELS_PER_METER=10
EARSHT_RADIUS_PX=100
# Client -> server position broadcast throttle.
POSITION_THROTTLE_MS=100

# --- Reliability / logging -------------------------------------------------
LOG_LEVEL=info
SPATIAL_QUERY_MODE=hybrid
SPATIAL_AUDIT_BUDGET_MS=20
PEER_STALE_MS=30000
HEARTBEAT_INTERVAL_MS=10000
CLUSTER_REFRESH_MS=2000
PRESENCE_FLUSH_MS=500

# --- Client (Vite reads these from client/.env, listed here for reference) --
# Leave unset for a production build: the client then talks to its own origin.
VITE_SERVER_URL=http://localhost:4000